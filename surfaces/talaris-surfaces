#
# Talaris's surfaces. Each of their windows is made a layer surface by itself
# (layershell.py), so the one process holds ordinary windows too.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
if [ "$#" -eq 0 ]; then
  # No compositor to draw on — the session ended, and the service's restart
  # came after it. Step aside cleanly (exit 0, so systemd stops trying) and
  # let the next session's exec-once start the surfaces with its own display.
  # Crashing here instead loops until systemd gives up on the unit.
  if [ ! -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY:-wayland-0}" ]; then
    echo "talaris-surfaces: no Wayland display (${WAYLAND_DISPLAY:-unset}); waiting for the next session to start me" >&2
    exit 0
  fi
  export QT_QPA_PLATFORM=wayland
  # Chromium animates every scroll step; a trackpad sends a stream of small
  # ones, and animated, the page lags behind the fingers and jumps to catch up.
  # And every page of Talaris's is one site (talaris-ui://), so it shares its
  # renderers rather than taking one each — some twenty pages, 100–150 MB apiece.
  export QTWEBENGINE_CHROMIUM_FLAGS="${QTWEBENGINE_CHROMIUM_FLAGS:-} --disable-smooth-scrolling --process-per-site"
fi
# Demo mode (the core's demo.ts): the mark in the person's own settings folder
# puts the surfaces in the demo world too — its settings, its Projects folder —
# and tells the calendar to show the demo's events, not the accounts'.
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/talaris"
if [ -f "$CONF/demo" ] && [ -z "${TALARIS_CONFIG_DIR:-}" ]; then
  export TALARIS_DEMO=1
  export TALARIS_DEMO_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/talaris-demo"
  export TALARIS_CONFIG_DIR="$TALARIS_DEMO_ROOT/config"
  export TALARIS_PROJECTS="$TALARIS_DEMO_ROOT/Projects"
  mkdir -p "$TALARIS_CONFIG_DIR"
  # The demo looks as Talaris does here: the person's settings, copied the first time.
  [ -f "$TALARIS_CONFIG_DIR/config.json" ] || { [ -f "$CONF/config.json" ] && cp "$CONF/config.json" "$TALARIS_CONFIG_DIR/config.json"; } || true
fi
exec python3 "$HERE/surfaces.py" "$@"
