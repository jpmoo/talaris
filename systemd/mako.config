# mako, in Talaris's default look (surfaces/ui/tokens.css): dark grays, the
# muted orange accent, Barlow Semi Condensed, soft corners. Copied to
# ~/.config/mako/config by install.sh when there is none; yours to change.
# Talaris draws its own notifications once it holds the bus (DESIGN.md).

font=Barlow Semi Condensed 11
background-color=#222528
text-color=#d5d9dc
border-color=#3a3f44
border-size=1
border-radius=12
padding=12,14
margin=10
width=360
max-icon-size=40
default-timeout=6000
anchor=top-right
layer=overlay
progress-color=over #c98a5b

[urgency=low]
text-color=#868c92

[urgency=critical]
border-color=#c98a5b
default-timeout=0
