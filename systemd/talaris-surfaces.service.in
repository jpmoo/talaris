#
# Talaris's surfaces: the drawers, and later the bar, dock and launcher.
#
# Not started at login by systemd — it needs the compositor's environment,
# which only exists once Hyprland is up. talaris.conf's exec-once imports that
# environment into the user manager and starts this. A service rather than a
# scope because a crashed surfaces process is a blank desktop: it restarts.

[Unit]
Description=Talaris surfaces — the bar, the dock and the drawers
Documentation=file://__ROOT__/DESIGN.md
Wants=talaris-core.service
After=talaris-core.service

[Service]
Type=simple
ExecStart=__ROOT__/surfaces/talaris-surfaces
Restart=on-failure
RestartSec=2
# Stopped, the surfaces alone are told: they put their pages away and leave, and
# only then are QtWebEngine's own processes ended. Told all at once (the
# default), those die first, under pages still drawn, and the surfaces abort
# ("Failed to restore OpenGL context after clean-up") — a core dump a stop.
KillMode=mixed
TimeoutStopSec=5
