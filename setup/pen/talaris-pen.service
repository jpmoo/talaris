# The pen, in an order Hyprland does not drop (talaris-pen; setup/pen/install.sh).
[Unit]
Description=Talaris pen: a touch held until the pen's coming near has been said
After=systemd-udevd.service

[Service]
# /run/talaris-pen: which end of the pen is near (`end`), for Talaris to read.
RuntimeDirectory=talaris-pen
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 -I /usr/local/lib/talaris/talaris-pen
Restart=always
RestartSec=3
# Root for the pen's device and uinput, and nothing else.
# Read-only home and /run/user: Talaris's word on the screen's turn (talaris-turn) is read there.
ProtectHome=read-only
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
